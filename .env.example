# Copiar a .env y ajustar valores.

# Puerto HTTP del contenedor PHP (publicado en el host)
HTTP_PORT=8080

# PostgreSQL
DB_USER=invernadero
DB_PASS=invernadero
DB_NAME=invernadero

# JWT
JWT_SECRET=cambiar-esta-clave-secreta
JWT_TTL=86400

# Exposición pública (opcional): token del túnel de Cloudflare.
# Obtenelo en: https://dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels
TUNNEL_TOKEN=
